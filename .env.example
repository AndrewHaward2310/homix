# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# PostgreSQL (Prisma). Với Supabase dùng 2 chuỗi:
#  - DATABASE_URL = POOLED (Supavisor, cổng 6543) — cho runtime/serverless.
#  - DIRECT_URL   = DIRECT (cổng 5432) — cho migrate/seed.
# Lấy ở Supabase: nút "Connect" hoặc Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# Khoá ký JWT — đặt chuỗi ngẫu nhiên đủ dài (vd: openssl rand -base64 32).
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# (tuỳ chọn) URL công khai của site khi deploy, dùng cho metadata/OG.
# NEXT_PUBLIC_SITE_URL="https://homix.vercel.app"
