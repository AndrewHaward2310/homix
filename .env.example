# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# 📖 Hướng dẫn lấy TỪNG key (từng bước, nơi lấy): docs/api-keys-guide.md

# ============================================================
# Phần A — BẮT BUỘC để web chạy
# ============================================================

# PostgreSQL (Prisma) qua Supabase. Dùng chuỗi "Session pooler" (host
# aws-0-...pooler.supabase.com, cổng 5432) cho CẢ HAI — pooler có IPv4, hợp
# migrate/serverless. (Chuỗi direct db.<ref>.supabase.co hiện chỉ có IPv6.)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Khoá ký JWT — chuỗi ngẫu nhiên đủ dài: openssl rand -base64 48
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# Supabase Storage — tải/thay ảnh bất động sản. Bucket public tên `property-images`.
# Lấy ở Supabase → Settings → API. SERVICE_ROLE_KEY là khoá BÍ MẬT (chỉ server).
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-bi-mat>"

# URL công khai của site khi deploy (metadata/OG/canonical).
NEXT_PUBLIC_SITE_URL="https://homix-seven.vercel.app"

# ============================================================
# Phần B — TUỲ CHỌN (bật thêm tính năng; thiếu thì app tự fallback)
# ============================================================

# Google Maps thật (thiếu → giữ maplibre). Nhớ Restrict theo HTTP referrer.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Blog/tin BĐS bằng AI (thiếu → dùng bài seed thủ công).
# ANTHROPIC_API_KEY=
# BLOG_RSS_FEEDS=

# Email & SMS xác nhận thật (thiếu → chỉ mô phỏng trong demo).
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Thanh toán thật (thiếu → thanh toán demo, không trừ tiền thật).
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_RETURN_URL=
