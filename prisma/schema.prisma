// Ocean Park — Prisma schema.
// Phản chiếu hợp đồng dữ liệu ở types/index.ts. LocalizedText (title/description/name)
// lưu JSONB. Response API map lại đúng shape các type đó, không lộ model Prisma ra ngoài.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: chuỗi POOLED (Supabase Supavisor, cổng 6543) — hợp serverless/Vercel.
  url       = env("DATABASE_URL")
  // Migrate/seed: chuỗi DIRECT (cổng 5432). Nếu không đặt DIRECT_URL, Prisma dùng url.
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  host
  agent
  admin
}

enum AgentFunction {
  sales
  care
  both
}

enum TowerStatus {
  selling
  sold_out
  coming_soon
}

enum PropertyType {
  sale
  rent_long
  stay_short
}

enum PropertyStatus {
  available
  reserved
  unavailable
}

enum BookingStatus {
  pending
  approved
  declined
  cancelled
  completed
}

enum LeadStage {
  new
  consulting
  closed
}

enum PerkCategory {
  bbq
  lake_ticket
  vehicle
  other
}

model User {
  id              String   @id
  name            String
  email           String   @unique
  passwordHash    String
  role            Role
  avatarUrl       String
  phone           String?
  preferredLocale String   @default("vi") // LocaleCode: vi | en | ko | zh
  agentFunction   AgentFunction?

  // Quan hệ
  properties      Property[] @relation("HostProperties")
  bookings        Booking[]  @relation("CustomerBookings")
  leads           Lead[]     @relation("AgentLeads")
  favorites       Favorite[]
  reviews         Review[]   @relation("CustomerReviews")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Tower {
  id           String      @id
  name         String
  // coords [lat, lng] ở type Tower; tách 2 cột cho rõ ràng, ghép lại khi serialize.
  lat          Float
  lng          Float
  priceFromVnd BigInt
  status       TowerStatus
  image        String

  // Metadata masterplan (trước đây hardcode ở MASTERPLAN_META trong propertyService.ts).
  mapLng       Float?
  mapLat       Float?
  bedroomsMin  Int?
  bedroomsMax  Int?
  amenities    String[]    @default([])

  properties   Property[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id          String         @id
  code        String         @unique
  title       Json // LocalizedText
  description Json // LocalizedText
  type        PropertyType
  areaM2      Float
  bedrooms    Int
  bathrooms   Int
  priceVnd    BigInt
  images      String[]       @default([])
  amenities   String[]       @default([])
  status      PropertyStatus
  verified    Boolean        @default(false)
  ratingAvg   Float?
  reviewCount Int            @default(0)

  tower       Tower          @relation(fields: [towerId], references: [id])
  towerId     String
  host        User           @relation("HostProperties", fields: [hostId], references: [id])
  hostId      String

  bookings    Booking[]
  favorites   Favorite[]
  reviews     Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([towerId])
  @@index([status])
}

model Favorite {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id])
  customerId String
  rating     Int
  comment    String
  /// Ảnh khách tự chụp (public URL trong bucket). Rỗng nếu không đính kèm.
  images     String[] @default([])
  createdAt  DateTime @default(now())

  @@unique([propertyId, customerId]) // mỗi khách 1 đánh giá / căn (chống trùng ở DB)
  @@index([propertyId])
}

model Booking {
  id         String        @id @default(cuid())
  property   Property      @relation(fields: [propertyId], references: [id])
  propertyId String
  customer   User          @relation("CustomerBookings", fields: [customerId], references: [id])
  customerId String
  type       PropertyType // BookingType = PropertyType
  checkIn    String? // stay_short: ngày nhận phòng (YYYY-MM-DD)
  checkOut   String? // stay_short: ngày trả phòng
  viewingAt  String? // sale/rent_long: thời điểm hẹn xem (ISO)
  status     BookingStatus @default(pending)
  /// Trải nghiệm đặt kèm (combo tự thiết kế): [{ perkId, qty, priceVnd, name }].
  /// Lưu SNAPSHOT giá lúc đặt để sau này perk đổi giá không làm sai đơn cũ.
  perks      Json?
  /// Tổng cuối cùng SAU giảm giá bậc thang (server tính, không tin client).
  totalVnd   BigInt        @default(0)
  createdAt  DateTime      @default(now())

  @@index([customerId])
  @@index([propertyId])
}

model Lead {
  id                 String    @id @default(cuid())
  customerName       String
  contact            String
  needSummary        String
  stage              LeadStage @default(new)
  agent              User      @relation("AgentLeads", fields: [assignedAgentId], references: [id])
  assignedAgentId    String
  matchedPropertyIds String[]  @default([])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([assignedAgentId])
}

model Perk {
  id        String       @id
  name      Json // LocalizedText
  priceVnd  BigInt
  category  PerkCategory

  createdAt DateTime @default(now())
}

/// Bậc giảm giá cho combo khách TỰ THIẾT KẾ: càng thêm nhiều trải nghiệm càng giảm sâu.
/// Admin chỉnh trực tiếp ở /admin/settings (không hardcode trong mã).
model ComboDiscountTier {
  id        String   @id @default(cuid())
  /// Số trải nghiệm tối thiểu để đạt bậc này (1, 2, 3...)
  minPerks  Int      @unique
  /// Phần trăm giảm trên tổng giá mua lẻ (0–100)
  percent   Float
  /// Trần số tiền được giảm (VND). null = không giới hạn.
  maxDiscountVnd BigInt?
  active    Boolean  @default(true)

  updatedAt DateTime @updatedAt
}
